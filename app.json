{
  "expo": {
    "name": "Kissa",
    "slug": "kissa-ai-story-chat",
    "version": "2.17.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kissa",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kissa.storychat",
      "buildNumber": "40"
    },
    "android": {
      "package": "com.kissa.storychat",
      "versionCode": 52,
      "adaptiveIcon": {
        "backgroundColor": "#0A0B10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-updates",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E9435E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Kissa to use Face ID to unlock the app."
        }
      ]
    ],
    "extra": {
      "KISSA_CONTENT_API_BASE_URL": "https://beyondredeye.site/api",
      "supportEmail": "ytdjbhai34@gmail.com",
      "KISSA_OTA_BASE_URL": "https://beyondredeye.site/api/ota"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ALWAYS",
      "fallbackToCacheTimeout": 0,
      "url": "https://beyondredeye.site/api/ota/manifest",
      "codeSigningCertificate": "./assets/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "root",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
