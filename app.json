{
  "expo": {
    "name": "Kissa",
    "slug": "kissa-ai-story-chat",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kissa",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06060A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kissa.storychat",
      "buildNumber": "18"
    },
    "android": {
      "package": "com.kissa.storychat",
      "versionCode": 18,
      "adaptiveIcon": {
        "backgroundColor": "#06060A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E9435E"
        }
      ]
    ],
    "extra": {
      "KISSA_CONTENT_API_BASE_URL": "https://beyondredeye.site/api",
      "supportEmail": "support@example.com"
    }
  }
}
