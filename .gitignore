# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Android prebuild output (generated in CI, never commit)
/android/
/ios/

# Build artifacts
*.apk
*.aab
*.ipa

# Secrets - NEVER commit these
.env
.env.*
*.pem
google-services.json
GoogleService-Info.plist
kissa-backup*.json

# misc
.DS_Store
coverage/
__pycache__/

# AnkitCutz Android editor (editor/) — Gradle output, never commit
/editor/.gradle/
/editor/build/
/editor/app/build/
/editor/local.properties
/editor/.idea/
/editor/captures/

# generated by docs/promo/gemini-key/build_gemini_tutorial.py
/docs/promo/gemini-key/__pycache__/
docs/promo/gemini-key/bed.wav

# OTA build output (never committed)
.ota-export/
.ota-export.tgz

# OTA code signing: the PRIVATE key never ships (GitHub secret OTA_SIGNING_KEY +
# Worker secret). Only the public certificate is committed.
keys/
private-key.pem
*.pk8
# ...but the public certificate must be in the repo: app.json pins it and the
# app refuses updates it cannot verify with it.
!assets/certificate.pem
OTA_SIGNING_KEY.txt
